```{=html}
<ul class="pub-list list">
<% const typeLabel = { journal: "Journal", conference: "Conference", workshop: "Workshop" }; %>
<% const typeIcon = { journal: "bi-journal-text", conference: "bi-people", workshop: "bi-tools" }; %>
<% for (const item of items) { %>
  <% const ptype = (item.pubtype || "").toString().toLowerCase(); %>
  <li <%= metadataAttrs(item) %> data-pubtype="<%= ptype %>" data-year="<%= item.year || "" %>">
    <div class="pub-row">

      <% const thumb = item.thumbnail || item.image; %>
      <% if (thumb) { %>
        <a class="pub-thumb" href="<%- item.path %>">
          <img src="<%- thumb %>" alt="Thumbnail for <%= item.title %>">
        </a>
      <% } else { %>
        <a class="pub-thumb pub-thumb-empty pt-<%= ptype %>" href="<%- item.path %>" aria-hidden="true" tabindex="-1">
          <i class="bi <%= typeIcon[ptype] || "bi-file-earmark-text" %>"></i>
          <span><%= typeLabel[ptype] || "Paper" %></span>
        </a>
      <% } %>

      <div class="pub-main">
        <div class="listing-title lead">
          <a href="<%- item.path %>" class="pub-title-link"><%= item.title %></a>
        </div>

        <% if (item.author) { %>
          <% const authors = Array.isArray(item.author) ? item.author.join(", ") : String(item.author); %>
          <% const parts = authors.split("Kundan Kumar"); %>
          <div class="listing-author"><% parts.forEach((p, i) => { %><%= p %><% if (i < parts.length - 1) { %><strong class="author-me">Kundan Kumar</strong><% } %><% }) %></div>
        <% } %>

        <div class="pub-meta">
          <% if (typeLabel[ptype]) { %>
            <span class="pub-type pt-<%= ptype %>"><%= typeLabel[ptype] %></span>
          <% } %>
          <% if (item.publication) { %>
            <span class="listing-publication fst-italic"><%= item.publication %></span>
          <% } %>
          <% if (item.status) { %>
            <span class="pub-status"><%= item.status %></span>
          <% } %>
        </div>

        <div class="paper-actions">
          <a href="<%- item.path %>" class="pub-btn pub-details">Details</a>

          <% if (item.doi) { %>
            <a href="<%- /^https?:\/\//.test(item.doi) ? item.doi : 'https://doi.org/' + item.doi %>" class="pub-btn pub-paper" target="_blank" rel="noopener noreferrer"> DOI</a>
          <% } %>

          <% if (item.preprint) { %>
            <a href="<%- item.preprint %>" class="pub-btn pub-paper" target="_blank" rel="noopener noreferrer"> Paper</a>
          <% } %>

          <% if (item.materials) { %>
            <a href="<%- item.materials %>" class="pub-btn pub-code" target="_blank" rel="noopener noreferrer"> Code</a>
          <% } %>

          <% if (item.slides) { %>
            <a href="<%- item.slides %>" class="pub-btn pub-pres" target="_blank" rel="noopener noreferrer"> Presentation</a>
          <% } %>

          <% if (item.poster) { %>
            <a href="<%- item.poster %>" class="pub-btn pub-poster" target="_blank" rel="noopener noreferrer"> Poster</a>
          <% } %>
        </div>
      </div>

      <% if (item.year) { %>
        <div class="pub-year-side listing-year" aria-label="Year <%= item.year %>"><%= item.year %></div>
      <% } %>

    </div>
  </li>
<% } %>
</ul>
```
